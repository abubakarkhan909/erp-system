# Database (local SQLite file — no MySQL/XAMPP required)
# Path is relative to prisma/schema.prisma
DATABASE_URL="file:../data/jewelry.db"

# Auth
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="change-me-refresh-secret-long-random"
JWT_REFRESH_EXPIRES_IN="7d"

# App
# API_PORT and API_HOST are injected at runtime by Electron (dynamic port selection).
# Do NOT hardcode these here — NestJS will read the file and override the injected env var.
# Default fallback in src/main.ts is 3847 if neither env var nor this file sets it.
# API_PORT=3847
# API_HOST=0.0.0.0
UPLOAD_DIR=./data/uploads
BACKUP_DIR=./data/backups
NODE_ENV=development

# Default admins are created by seed (hardcoded in prisma/seed.ts):
#   admin / admin@1234
#   zahid / zahid@1234
SEED_OWNER_USERNAME=admin
SEED_OWNER_PASSWORD=admin@1234
